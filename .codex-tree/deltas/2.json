            "signature": "pub fn new(client: ClaudeClient) -> Self",
            "parent": "Analyzer",
            "doc_comment": "/// Construct an `Analyzer` from an already-configured `ClaudeClient`.\n\n///\n\n/// In Scala: `new Analyzer(client)` — straightforward constructor injection.\n"
          },
          {
            "name": "analyze",
            "kind": "function",
            "visibility": "public",
            "span": {
              "start_line": 47,
              "end_line": 72
            },
            "signature": "pub async fn analyze(\n        &mut self,\n        codex_tree_dir: &Path,\n        modules: &[ModuleIndex],\n    ) -> Result<IntentOutput>",
            "parent": "Analyzer",
            "doc_comment": "/// Run intent analysis on the given modules.\n\n///\n\n/// Checks the content-hash cache first; calls the Claude API only on a\n\n/// cache miss.  On a successful API call the result is cached before\n\n/// returning.\n\n///\n\n/// # Errors\n\n/// Propagates any error from the Claude client (network, budget, API key)\n\n/// or the response parser.  Cache misses and cache write failures are\n\n/// treated as non-fatal and silently ignored.\n"
          },
          {
            "name": "write_intent",
            "kind": "function",
            "visibility": "public",
            "span": {
              "start_line": 84,
              "end_line": 97
            },
            "signature": "pub fn write_intent(codex_tree_dir: &Path, output: &IntentOutput) -> Result<()>",
            "doc_comment": "/// Write intent output to disk as `intent/decisions.json` and\n\n/// `intent/patterns.json` under `codex_tree_dir`.\n\n///\n\n/// Creates `intent/` if it doesn't exist.  Both JSON files are pretty-printed\n\n/// for human readability in the repository.\n\n///\n\n/// In Scala: `writeIntent(dir: Path, output: IntentOutput): IO[Unit]`\n"
          }
        ],
